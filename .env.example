# ------------------------------------------------------------------
# Настройки демонстрационного бота кибер-клуба NOVA ARENA
# Скопируйте этот файл в .env и заполните значения:
#     cp .env.example .env
# Файл .env не должен попадать в Git (уже добавлен в .gitignore).
# ------------------------------------------------------------------

# ОБЯЗАТЕЛЬНО. Токен бота, полученный у @BotFather (/newbot).
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ОБЯЗАТЕЛЬНО. Числовые Telegram ID администраторов клуба (не @username!),
# через запятую. Узнать свой ID: напишите боту @userinfobot.
#
#   ПЕРВЫЙ ID — владелец бота: он управляет списком администраторов
#   (добавляет, отключает, назначает роли) и защищён от удаления.
#   Остальные — обычные администраторы: получают новые брони и могут
#   подтверждать или отклонять их.
#
# Для одного администратора достаточно: ADMIN_IDS=123456789
ADMIN_IDS=123456789,987654321

# ------------------------------------------------------------------
# Сведения о клубе (по умолчанию — полностью вымышленные демо-данные).
# Поменяйте их под свой проект, и все карточки/подписи обновятся сами.
# ------------------------------------------------------------------

# Название клуба (в карточках, шапках и приветствии).
CLUB_NAME=NOVA ARENA

# Город (демонстрационный).
CLUB_CITY=Неополис

# Адрес (демонстрационный).
CLUB_ADDRESS=пр-т Кибернетиков, 42 (ТЦ «Орион», 3 этаж)

# Часы работы.
CLUB_HOURS=круглосуточно, 24/7

# Контактное лицо и телефон дежурного администратора (демо).
ADMIN_NAME=Дежурный администратор (демо)
ADMIN_PHONE=+7 (900) 000-42-42

# Вымышленные реквизиты предоплаты для демонстрации шага оплаты.
PAYMENT_SYSTEM=Демо-Банк (СБП)
PAYMENT_CARD=+7 (900) 000-77-88
PAYMENT_HOLDER=Алексей Н. (демо)

# Контакт автора/интегратора для полей About и Description профиля бота
# (автоматически синхронизируется с Telegram при запуске main.py).
BOT_CONTACT=@ваш_ник

# 10-тоновые RGB-иконки для inline-кнопок (icon_custom_emoji_id, Bot API 9.4+):
#   auto — при старте бот сам создаст/подключит набор custom_emoji из
#          bot/assets/button_icons/*.png (если у владельца бота есть Premium,
#          кнопки получат 24-битные векторные бейджи; иначе автоматический откат
#          на аккуратные цветовые глифы без ошибок);
#   off  — использовать только стандартные глифы без icon_custom_emoji_id.
INLINE_CUSTOM_ICONS=auto
# Необязательно: явная привязка своих custom_emoji_id по тонам
# (mint, amber, tangerine, cryo, sapphire, amethyst, indigo, jade, ruby, slate):
# INLINE_EMOJI_IDS=mint=5368324170671202286,amber=5368324170671202287

# ------------------------------------------------------------------
# Технические настройки
# ------------------------------------------------------------------

# Путь к файлу базы SQLite (относительный — от корня проекта).
DB_PATH=data/nova_demo.db

# Часовой пояс клуба. По умолчанию: Europe/Moscow (UTC+3).
TZ=Europe/Moscow

# Уровень логов: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
