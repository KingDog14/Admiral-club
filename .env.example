# ------------------------------------------------------------------
# Настройки бота ПК-клуба ADMIRAL
# Скопируйте этот файл в .env и заполните значения:
#     cp .env.example .env
# Файл .env не должен попадать в Git (уже добавлен в .gitignore).
# ------------------------------------------------------------------

# ОБЯЗАТЕЛЬНО. Токен бота, полученный у @BotFather (/newbot).
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ОБЯЗАТЕЛЬНО. Числовые Telegram ID администраторов клуба (не @username!),
# через запятую. Узнать свой ID: напишите боту @userinfobot.
#
#   ПЕРВЫЙ ID — владелец бота: он управляет списком администраторов
#   (добавляет, отключает, назначает роли) и защищён от удаления.
#   Остальные — обычные администраторы: получают новые брони и могут
#   подтверждать или отклонять их.
#
# Для одного администратора достаточно: ADMIN_IDS=123456789
ADMIN_IDS=123456789,987654321

# Администраторов можно добавлять и без правки этого файла — командой /admins
# в боте (доступно владельцу). .env задаёт только стартовый, обязательный набор.
# Устаревший вариант ADMIN_ID=123456789 (один администратор) тоже понимается.

# Необязательно. Путь к файлу базы SQLite (относительный — от корня проекта).
# Каталог создаётся автоматически. По умолчанию: data/admiral.db
DB_PATH=data/admiral.db

# Необязательно. Часовой пояс клуба — по нему считается «сейчас», ночной тариф
# и время в админ-панели. По умолчанию: Asia/Sakhalin
TZ=Asia/Sakhalin

# Необязательно. Уровень логов: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
