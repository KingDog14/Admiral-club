# ------------------------------------------------------------------
# Настройки бота компьютерного клуба ADMIRAL (Чита)
# Скопируйте этот файл в .env и заполните значения:
#     cp .env.example .env
# Файл .env не должен попадать в Git (уже добавлен в .gitignore).
# ------------------------------------------------------------------

# ОБЯЗАТЕЛЬНО. Токен бота, полученный у @BotFather (/newbot).
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ОБЯЗАТЕЛЬНО. Числовые Telegram ID администраторов клуба (не @username!),
# через запятую. Узнать свой ID: напишите боту @userinfobot.
#
#   ПЕРВЫЙ ID — владелец бота: он управляет списком администраторов
#   (добавляет, отключает, назначает роли) и защищён от удаления.
#   Остальные — обычные администраторы: получают новые брони и могут
#   подтверждать или отклонять их.
#
# Для одного администратора достаточно: ADMIN_IDS=123456789
ADMIN_IDS=123456789,987654321

# Администраторов можно добавлять и без правки этого файла — командой /admins
# в боте (доступно владельцу). .env задаёт только стартовый, обязательный набор.
# Устаревший вариант ADMIN_ID=123456789 (один администратор) тоже понимается.

# ------------------------------------------------------------------
# Сведения о клубе. Всё необязательно: значения ниже — реальные данные
# клуба ADMIRAL в Чите и подходят «из коробки». Поменяйте их под себя,
# и тексты бота обновятся без правки кода.
# ------------------------------------------------------------------

# Название клуба (в шапках и приветствии).
CLUB_NAME=ADMIRAL

# Город.
CLUB_CITY=Чита

# Адрес — показывается в приветствии, контактах и FAQ.
CLUB_ADDRESS=ул. Подгорбунского, 37 (2 помещение, 1 этаж, вход с торца)

# Часы работы — в приветствии и контактах.
CLUB_HOURS=круглосуточно, 24/7

# Кто отвечает на вопросы гостей. Именно этот человек «администратор» для
# клиента: его имя и телефон уходят в сообщения про отказ и контакты.
# Поставьте того, кого назначит владелец клуба.
ADMIN_NAME=Администратор клуба

# Телефон клуба: он же показывается как контакт (кнопка «позвонить»)
# и как номер, по которому просят звонить при любых сомнениях.
ADMIN_PHONE=+7 999 299-35-35

# Реквизиты предоплаты. У клуба ЕДИНЫЙ номер — другой быть не должно,
# иначе гостей легче обмануть. Предоплата берётся только на ночные пакеты
# и только в выходные (ПТ–ВС); в остальных случаях можно платить на месте.
PAYMENT_SYSTEM=Сбербанк
PAYMENT_CARD=+79143618141
PAYMENT_HOLDER=Тимур В.

# ------------------------------------------------------------------
# Технические настройки
# ------------------------------------------------------------------

# Необязательно. Путь к файлу базы SQLite (относительный — от корня проекта).
# Каталог создаётся автоматически. По умолчанию: data/admiral.db
DB_PATH=data/admiral.db

# Необязательно. Часовой пояс клуба — по нему считается «сейчас», ночной пакет
# и время в админ-панели. По умолчанию: Asia/Chita (UTC+9)
TZ=Asia/Chita

# Необязательно. Уровень логов: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
